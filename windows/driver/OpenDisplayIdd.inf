;
; OpenDisplayIdd.inf
;
; Installation file for OpenDisplay USB Virtual Display Indirect Display Driver (IddCx)
;

[Version]
Signature="$Windows NT$"
Class=Display
ClassGuid={4d36e968-e325-11ce-bfc1-08002be10318}
Provider=%ManufacturerName%
CatalogFile=OpenDisplayIdd.cat
DriverVer=09/20/2026,1.0.0.1
PnpLockdown=1

[Manufacturer]
%ManufacturerName%=Standard,NTamd64

[Standard.NTamd64]
%DeviceName%=OpenDisplayIdd_Install, Root\OpenDisplayIdd

[OpenDisplayIdd_Install.NT]
CopyFiles=UMDriverCopy
FeatureScore=FB

[UMDriverCopy]
OpenDisplayIdd.dll

[DestinationDirs]
UMDriverCopy=12,UMDF ; \Windows\System32\drivers\UMDF

[OpenDisplayIdd_Install.NT.Services]
AddService=WUDFRd,0x000001fa,WUDFRD_ServiceInstall

[WUDFRD_ServiceInstall]
DisplayName = %WudfRdDisplayName%
ServiceType = 1
StartType = 3
ErrorControl = 1
ServiceBinary = %12%\WUDFRd.sys

[OpenDisplayIdd_Install.NT.Wdf]
UmdfService=OpenDisplayIdd,OpenDisplayIdd_Install
UmdfServiceOrder=OpenDisplayIdd

[OpenDisplayIdd_Install]
UmdfLibraryVersion=2.31
ServiceBinary=%12%\UMDF\OpenDisplayIdd.dll

[Strings]
ManufacturerName="OpenDisplay USB Project"
DeviceName="OpenDisplay USB Virtual Display Adapter"
WudfRdDisplayName="Windows Driver Foundation - User-mode Driver Framework Reflector"
